# Don’s HVAC Services — environment variables
# Copy to .env.local for local development. Never commit real values.
# Each environment (local, Vercel demo/preview, future live) uses its OWN
# Supabase project, email settings and analytics — see README.

# ── Site & indexing policy (src/config/site.ts) ─────────────────────────────
# demo (default) = noindex everywhere. live = indexable ONLY on the canonical
# host, and only when SITE_CANONICAL_ORIGIN is a valid approved https origin.
SITE_MODE=demo
# Approved canonical origin, live only. Example: https://www.donshvac.ca
SITE_CANONICAL_ORIGIN=
# Comma-separated approved alternate hosts that 308-redirect to the canonical
# host in one hop (live only). Example: donshvac.ca
SITE_REDIRECT_HOSTS=
# Optional explicit origin for absolute URLs in demo mode (share images).
# Defaults to the Vercel production/branch URL, or http://localhost:3000.
SITE_DEMO_ORIGIN=
# Allow model-training crawlers (GPTBot, Google-Extended, CCBot…) in robots.txt.
# Search/answer crawlers (Googlebot, Bingbot, OAI-SearchBot…) are allowed on the
# live host regardless.
SITE_ALLOW_AI_TRAINING=false

# ── Supabase (project CMS + owner sign-in) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by the inquiry rate limiter and operator scripts. Never
# expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SECRET_KEY=
# Scripts only (npm run db:apply). Session pooler connection string.
SUPABASE_DB_URL=
# Optional extra allow-list of owner auth user ids (comma-separated). The
# database owners table is always enforced as well.
OWNER_USER_IDS=

# ── Inquiry delivery ────────────────────────────────────────────────────────
# sink     = local/demo test sink (default when SITE_MODE=demo); writes JSON to
#            .data/inquiry-sink/ in development only, sends nothing.
# resend   = send through Resend. Demo mode ALWAYS sends to INQUIRY_DEMO_TO.
# disabled = never send; visitors get the phone + "Email my request" fallback.
# fail     = simulate a provider failure (testing).
INQUIRY_DELIVERY=sink
RESEND_API_KEY=
# Verified sender, e.g. "Don’s HVAC website <inquiries@your-verified-domain>"
INQUIRY_FROM=
# Live recipient (Don’s inbox). Ignored unless SITE_MODE=live is in effect.
INQUIRY_TO=
# Controlled demo/test recipient (your own inbox). Used in demo mode.
INQUIRY_DEMO_TO=
# Secret for form timing tokens and rate-limit hashing (32+ random chars).
FORM_TOKEN_SECRET=

# ── Analytics (off unless set) ──────────────────────────────────────────────
# vercel = Vercel Web Analytics + conversion events. Leave empty to disable.
NEXT_PUBLIC_ANALYTICS=
# Labels events so demo/test traffic is separable: demo | live
NEXT_PUBLIC_SITE_ENV_LABEL=demo

# ── Search engine verification (live only; emitted only when indexable) ────
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
